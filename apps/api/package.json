{
  "name": "@fundilink/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json || exit 0",
    "start:dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"wait-on -d 500 dist/main.js && node --watch dist/main.js\"",
    "start:prod": "node ../../scripts/db.mjs migrate && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "seed:demo:purge": "node dist/scripts/seed-demo.js --purge"
  },
  "dependencies": {
    "@fundilink/domain": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.12.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.8.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "main": "dist/main.js"
}
